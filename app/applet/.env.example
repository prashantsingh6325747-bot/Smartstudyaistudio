# =============================================================================
# SMART STUDY AI (MITS GWALIOR) - ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the root of your project
# =============================================================================

# 1. DATABASE (MongoDB Atlas or Local MongoDB)
# When set, all users, admins, notes, and records persist permanently across restarts.
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartstudy?retryWrites=true&w=majority

# 2. AI MODEL (Google Gemini API Key)
# Powers the real-time MITS Study Assistant with RAG retrieval from college notes:
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OTP & EMAIL DELIVERY (Resend)
# Used to send real verification OTP codes to student/faculty emails:
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Smart Study AI <onboarding@resend.dev>"

# 4. SECURITY & SESSIONS
# A strong random secret used for signing JWT cookies and OTP tokens:
JWT_SECRET=mits-smart-study-production-secret-change-this-32-chars

# 5. OPTIONAL: SMTP Fallback (if using Gmail / Outlook instead of Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@mitsgwl.ac.in
# SMTP_PASS=your-app-password
