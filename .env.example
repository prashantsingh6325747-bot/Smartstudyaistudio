# Smart Study AI Environment Variables

# MongoDB Atlas or self-hosted MongoDB connection string (Direct MongoDB connection)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartstudy?retryWrites=true&w=majority
MONGODB_URI=

# Optional: MongoDB HTTP API service URL and key (if using the mongo-api proxy)
MONGO_API_URL=
MONGO_API_KEY=

# Secret key for JWT session tokens and OTP signatures (a default is provided in development)
JWT_SECRET=

# Resend API key for sending OTP emails to students
RESEND_API_KEY=


